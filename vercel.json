{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'sha256-xUZtZS1nWJaAyUqA7ZKgkLhjdEisnY0MiRmax16aGFg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: http:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/assets/[^/]+-[A-Za-z0-9_-]+\\.(js|css)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/exercise-media/.*",
      "headers": {
        "Cache-Control": "public, max-age=2592000, immutable",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/(sw\\.js|index\\.html|manifest\\.json)?",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(api|assets|exercise-media|app-icons)(/.*)?",
      "status": 404
    },
    {
      "src": "/.*\\.[^/]*",
      "status": 404
    },
    {
      "src": "/(.*)",
      "status": 302,
      "headers": {
        "Location": "/#/$1"
      }
    }
  ]
}
