{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "VITE_STATIC=1 vite build && node ../scripts/catalogue/stage-media.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en,de,ar --paper A4,Letter --check"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "jsqr": "^1.4.0",
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "linkedom": "^0.18.13",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
